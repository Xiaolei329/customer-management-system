<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mapper.DictionaryMapper">

    <select id="selectByTypeName" resultType="com.entity.DictionaryEntity">
        select * from  dictionary_t  WHERE dict_type_name = #{dict_type_name}
    </select>

</mapper>